  ],
  "buildPresets": [{"name": "product-release", "configurePreset": "product-win32", "configuration": "Release"}],
  "testPresets": [{"name": "product-core", "configurePreset": "product-win32", "configuration": "Release", "output": {"outputOnFailure": true}}]
}
