{
  "version": 3,
  "configurePresets": [
    {
      "name": "product-win32",
      "displayName": "Source-only Producer (Win32)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/work/build/product",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
